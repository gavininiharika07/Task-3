#include <stdio.h>

struct Student {
    int id;
    char name[30];
    float marks;
};

int main() {
    struct Student s[10];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for(i=0; i<n; i++) {
        printf("\nStudent %d\n", i+1);

        printf("Enter ID: ");
        scanf("%d", &s[i].id);

        printf("Enter Name: ");
        scanf("%s", s[i].name);

        printf("Enter Marks: ");
        scanf("%f", &s[i].marks);
    }

    printf("\nStudent Records\n");
    printf("ID\tName\tMarks\n");

    for(i=0; i<n; i++) {
        printf("%d\t%s\t%.2f\n",
               s[i].id,
               s[i].name,
               s[i].marks);
    }

    return 0;
}
